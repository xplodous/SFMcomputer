EVERY 1 TICK DO
    IF N SLOT 1 HAS = 4 THEN -- IF N GUY IS DONE
        --PROPAGATE VALUE AND CONTROL BACKWARDS, CLEAN
        INPUT FROM B --CLEAN HOUSE
        OUTPUT TO S
        FORGET 
        INPUT FROM N SLOT 3 --PROPOGATE VALUE
        OUTPUT TO B SLOT 3
        FORGET
        INPUT FROM N SLOT 1
        OUTPUT TO B SLOT 1 -- MARK SELF AS DONE, CLEAN N GUY'S CONTROL
    ELSE IF B SLOT 1 HAS = 5 THEN -- PULL TIME
        IF B SLOT 4 HAS = 0 THEN
            --VALUE IS GOOD
            INPUT 1 FROM B SLOT 1
            INPUT FROM B SLOT 2
            OUTPUT TO S
            FORGET
        ELSE
            INPUT 1 FROM B SLOT 4
            --MOVE ONE ITEM BACK INTO D
            IF B SLOT 2 HAS = 0 THEN
                OUTPUT TO D SLOT 0
            ELSE IF B SLOT 2 HAS = 1 THEN
                OUTPUT TO D SLOT 1
            ELSE IF B SLOT 2 HAS = 2 THEN
                OUTPUT TO D SLOT 2
            ELSE IF B SLOT 2 HAS = 3 THEN
                OUTPUT TO D SLOT 3
            ELSE IF B SLOT 2 HAS = 4 THEN
                OUTPUT TO D SLOT 4
